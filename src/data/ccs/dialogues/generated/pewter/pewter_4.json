{
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face();"
    }
  },
  "pages": [
    {
      "id": "line_0",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "v.target_id='venonat';",
          "v.target_name='Venonat';",
          "v.pokemon_id='tangela';",
          "v.pokemon_name='Tangela';",
          "v.nickname='Crinkles';",
          "t.next_page = q.run_script('ccs:trade__landing');",
          "q.dialogue.set_page(t.next_page)"
        ]
      }
    },
    {
      "id": "line_1",
      "speaker": "npc",
      "lines": [
        {
          "type": "expression",
          "expression": "v.line_1;"
        }
      ],
      "input": {
        "type": "option",
        "vertical": true,
        "options": [
          {
            "text": "Yes",
            "value": "Yes",
            "isSelectable": "v.target_pokemon_uuid != 0;",
            "action": [
              "q.dialogue.set_page('trade');"
            ]
          },
          {
            "text": "No",
            "value": "No",
            "action": [
              "q.dialogue.set_page('bye');"
            ]
          }
        ]
      }
    },
    {
      "id": "trade",
      "speaker": "npc",
      "lines": [
        "Okay, connect the cable like so!"
      ],
      "input": [
        "v.player_party.remove_by_id(v.target_pokemon_uuid);",
        "q.run_command('pokegiveother ' + q.player.username() + ' ' + v.pokemon_id + ' ottype=NPC ot=Unknown nick=' + v.nickname);",
        "q.player.play_sound_on_server('ccs:pokemon_get','blocks');",
        "q.player.set_npc_variable(q.npc, 'traded', 1);",
        "q.dialogue.set_page('trade_2');"
      ]
    },
    {
      "id": "trade_2",
      "speaker": "npc",
      "lines": [
        {
          "type": "expression",
          "expression": "v.line_thanks;"
        }
      ],
      "input": [
        "q.dialogue.close();"
      ]
    },
    {
      "id": "traded",
      "speaker": "npc",
      "lines": [
        {
          "type": "expression",
          "expression": "v.line_traded;"
        }
      ],
      "input": [
        "q.dialogue.close();"
      ]
    },
    {
      "id": "bye",
      "speaker": "npc",
      "lines": [
        {
          "type": "expression",
          "expression": "v.line_bye;"
        }
      ],
      "input": [
        "q.dialogue.close();"
      ]
    }
  ]
}