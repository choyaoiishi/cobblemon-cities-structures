{
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face();"
    }
  },
  "pages": [
    {
      "id": "shop",
      "speaker": "npc",
      "lines": [
        "What do you need?"
      ],
      "input": {
        "type": "option",
        "vertical": true,
        "options": [
          {
            "text": "Buy",
            "value": "buy",
            "action": [
              "v.bank = 'pokemart';",
              "q.run_command('/execute as ' + q.player.username() + ' run cobblemerchant open shop ccs:' + pewter/pokemart);"
            ]
          },
          {
            "text": "Sell",
            "value": "sell",
            "isVisible": "v.bank != ''",
            "action": [
              "q.run_command('/execute as ' + q.player.username() + ' run cobblemerchant open bank ccs:'+ pokemart);"
            ]
          },
          {
            "text": "See ya!",
            "value": "bye",
            "action": [
              "q.dialogue.set_page('bye');"
            ]
          }
        ]
      }
    },
    {
      "id": "bye",
      "speaker": "npc",
      "lines": [
        "bye_text"
      ],
      "input": [
        "q.dialogue.close();"
      ]
    }
  ]
}