[
  {
    "id": "shop",
    "speaker": "npc",
    "lines": [],
    "input": {
      "type": "auto-continue",
      "delay": 0.01,
      "allowSkip": false,
      "action": [
        "v.bank = '#bank_id';",
        "q.dialogue.set_page('shop_1');"
      ]
    }
  },
  {
      "id": "shop_1",
      "speaker": "npc",
      "lines": [
        "#shop_text"
      ],
      "input": {
        "type": "option",
        "vertical": true,
        "options": [
          {
            "text": "Buy",
            "value": "buy",
            "action": [
            
              "q.run_command('/execute as ' + q.player.username() + ' run cobblemerchant open shop ccs:#shop_id');"
            ]
          },
          {
            "text": "Sell",
            "value": "sell",
            "isVisible": "!q.is_blank(v.bank)", 
            "action": [
              "q.run_command('/execute as ' + q.player.username() + ' run cobblemerchant open bank ccs:#bank_id');"
            ]
          },
          {
            "text": "See ya!",
            "value": "bye",
            "action": [
              "q.dialogue.set_page('bye');"
            ]
          }
        ]
      }
    },
    {
      "id": "bye",
      "speaker": "npc",
      "lines": [
        "#bye_text"
      ],
      "input": [
        "q.dialogue.close();"
      ]
    }
]