{
    "processors": [
        {
            "processor_type": "lithostitched:block_swap",
            "blocks": {
                // base
                "minecraft:crying_obsidian": "minecraft:red_sandstone",
                "minecraft:obsidian": "minecraft:red_sandstone",
                "minecraft:birch_log": "minecraft:packed_mud",
                "minecraft:birch_wood": "minecraft:packed_mud"
            }
        },
        {
            "processor_type": "lithostitched:condition",
            "random_mode": "per_block",
            "if_true": {
                "type": "lithostitched:all_of",
                "conditions": [
                    {
                        "type": "lithostitched:matching_blocks",
                        "blocks": "minecraft:packed_mud",
                        "match_type": "input"
                    }
                ]
            },
            "then": {
                "processor_type": "lithostitched:set_block",
                "state_provider": {
                    "type": "minecraft:weighted_state_provider",
                    "entries": [
                        {
                            "weight": 3,
                            "data": {
                                "Name": "minecraft:packed_mud"
                            }
                        },
                        {
                            "weight": 5,
                            "data": {
                                "Name": "minecraft:brown_mushroom_block"
                            }
                        },
                        {
                            "weight": 1,
                            "data": {
                                "Name": "minecraft:mud_bricks"
                            }
                        }
                    ]
                },
                "random_mode": "per_block"
            },
            "else": {
                "processor_type": "minecraft:nop"
            }
        }
    ]
}