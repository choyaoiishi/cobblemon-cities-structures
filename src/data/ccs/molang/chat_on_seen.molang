! q.entity.config.chat_on_seen_enable ? return 0;

q.run_script('ccs:is_debug') != 0 ? return 0;

math.mod(q.entity.world.game_time(), 5) != 0 ? return 0;

q.set_query('npc', q.entity);

t.range = q.npc.config.chat_range;
t.cooldown_ticks = q.npc.config.chat_cooldown_ticks;
v.player = 0;

for_each(t.nearby, q.npc.get_nearby_entities(t.range), {
    v.player = t.nearby.is_player() && q.npc.can_see(t.nearby, t.range) ? t.nearby : 0;
});

'no player';
v.player == 0 ? return 0;

'already won';
t.player = v.player.username();
q.get_variable(q.npc.data, t.player + '_win_cooldown') != 0 ? return 0;

t.player_ready = v.player.is_in_dialogue() != 1 && v.player.in_battle() != 1;
t.player_ready != 1 ? return 0;

v.player.world.game_time() < q.get_variable(q.npc.data, t.player + '_chat_cooldown') ? return 0;

q.set_query('player', v.player);
q.run_script('ccs:chat__set_cooldown');

q.npc.run_dialogue(v.player, q.npc.config.dialogue_selection);