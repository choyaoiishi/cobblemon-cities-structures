{
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face();"
    }
  },
  "pages": [
    {
      "id": "line_0",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "t.next_page = q.run_script('ccs:battle__landing');",
          "q.dialogue.set_page(t.next_page);"
        ]
      }
    },
    {
      "id": "line_1",
      "speaker": "npc",
      "lines": [
        "Are you the twerp messing with my grunts?"
      ],
      "input": [
        "q.dialogue.set_page('battle');"
      ]
    },
    {
      "id": "battle",
      "speaker": "npc",
      "lines": [
        "Little kid, you think you're brave, eh? I'll teach you a valuable lesson."
      ],
      "input": [
        "v.min_level='20';",
        "v.advancement='ccs:kanto/pewter/archer';",
        "q.player.set_npc_variable(q.npc, 'advancement', v.advancement);",
        "q.player.set_npc_variable(q.npc, 'trainer_id', 'rocket_archer');",
        "q.dialogue.close();",
        "!q.is_blank(v.min_level) ? q.player.set_npc_variable(q.npc, 'min_level', v.min_level);",
        "!q.is_blank(v.advancement) ? q.run_command('/execute at @e[type=marker,tag=rocket_archer,limit=1,sort=nearest] run tp ' + q.player.username() + ' ~ ~ ~ facing entity ' + q.npc.uuid() );",
        "q.npc.start_battle(q.player, 'single');"
      ]
    },
    {
      "id": "win",
      "speaker": "npc",
      "lines": [
        "Whatever, we've done everything we needed. I won't be as nice to you next time."
      ],
      "input": [
        "t.next_page = q.run_script('ccs:battle__landing_win');",
        "q.dialogue.set_page(t.next_page);"
      ]
    },
    {
      "id": "won",
      "speaker": "npc",
      "lines": [
        "I'll be seeing you."
      ],
      "input": [
        "q.dialogue.close();"
      ]
    },
    {
      "id": "bye",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "q.dialogue.close();"
        ]
      }
    }
  ]
}