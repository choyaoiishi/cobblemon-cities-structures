    {
      "id": "line_1",
      "speaker": "npc",
      "lines": [
        "Ah! So we meet again! The president and I are discussing a vital business proposition."
      ],
      "input": [
        "q.dialogue.set_page('battle');"
      ]
    },
    {
      "id": "battle",
      "speaker": "npc",
      "lines": [
        "Keep your nose out of grown-up matters... Or, experience a world of pain!"
      ],
      "input": [
        "v.min_level='50';",
        "v.advancement='ccs:kanto/saffron/giovanni';",
        "q.player.set_npc_variable(q.npc, 'advancement', v.advancement);",
        "q.player.set_npc_variable(q.npc, 'trainer_id', 'rocket_giovanni');",
        "q.dialogue.close();",
        "!q.is_blank(v.min_level) ? q.player.set_npc_variable(q.npc, 'min_level', v.min_level);",
        "!q.is_blank(v.advancement) ? q.run_command('/execute at @e[type=marker,tag=rocket_giovanni,limit=1,sort=nearest] run tp ' + q.player.username() + ' ~ ~ ~ facing entity ' + q.npc.uuid() );",
        "q.npc.start_battle(q.player, 'single');"
      ]
    },
    {
      "id": "win",
      "speaker": "npc",
      "lines": [
        "Arrgh!! I lost again!?"
      ],
      "input": [
        "t.next_page = q.run_script('ccs:battle__landing_win');",
