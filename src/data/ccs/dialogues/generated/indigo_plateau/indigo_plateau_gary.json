{
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face();"
    }
  },
  "pages": [
    {
      "id": "line_0",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "t.next_page = q.run_script('ccs:battle__landing');",
          "q.dialogue.set_page(t.next_page);"
        ]
      }
    },
    {
      "id": "line_1",
      "speaker": "npc",
      "lines": [
        "Hey, I was looking forward to seeing you!"
      ],
      "input": [
        "q.dialogue.set_page('line_2');"
      ]
    },
    {
      "id": "line_2",
      "speaker": "npc",
      "lines": [
        "My rival should be strong to keep me sharp."
      ],
      "input": [
        "q.dialogue.set_page('line_3');"
      ]
    },
    {
      "id": "line_3",
      "speaker": "npc",
      "lines": [
        "While working on my Pok\u00e9dex, I looked all over for Pok\u00e9mon."
      ],
      "input": [
        "q.dialogue.set_page('line_4');"
      ]
    },
    {
      "id": "line_4",
      "speaker": "npc",
      "lines": [
        "Not only that, I assembled teams that would beat any Pok\u00e9mon type."
      ],
      "input": [
        "q.dialogue.set_page('line_5');"
      ]
    },
    {
      "id": "line_5",
      "speaker": "npc",
      "lines": [
        "And now... I'm the Pok\u00e9mon League Champion!"
      ],
      "input": [
        "q.dialogue.set_page('line_6');"
      ]
    },
    {
      "id": "line_6",
      "speaker": "npc",
      "lines": [
        "Do you know what that means?"
      ],
      "input": [
        "q.dialogue.set_page('line_7');"
      ]
    },
    {
      "id": "line_7",
      "speaker": "npc",
      "lines": [
        "I'll tell you."
      ],
      "input": [
        "q.dialogue.set_page('battle');"
      ]
    },
    {
      "id": "battle",
      "speaker": "npc",
      "lines": [
        "I am the most powerful Trainer in the world!"
      ],
      "input": [
        "v.min_level=85;",
        "v.advancement='ccs:kanto/indigo_plateau/champion';",
        "q.npc.data.advancement=v.advancement;",
        "q.npc.data.trainer_id='rival_gary';",
        "q.dialogue.close();",
        "!q.is_blank(v.min_level) ? {q.npc.data.min_level=v.min_level;};",
        "!q.is_blank(v.advancement) ?{ q.run_command('/execute at @e[type=marker,tag=rival_gary,limit=1,sort=nearest] run tp ' + q.player.username() + ' ~ ~ ~ facing entity ' + q.npc.uuid() );};",
        "q.npc.start_battle(q.player, 'single');"
      ]
    },
    {
      "id": "win",
      "speaker": "npc",
      "lines": [
        "No! That can't be! You beat me at my best! After all that work to become the League Champ?"
      ],
      "input": [
        "t.next_page = q.run_script('ccs:battle__landing_win');",
        "q.dialogue.set_page(t.next_page);"
      ]
    },
    {
      "id": "won",
      "speaker": "npc",
      "lines": [
        "Why? Why did I lose? I never made any mistakes raising my Pok\u00e9mon... Darn it! You're the new Pok\u00e9mon League Champion!"
      ],
      "input": [
        "q.dialogue.close();"
      ]
    },
    {
      "id": "bye",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "q.dialogue.close();"
        ]
      }
    }
  ]
}