{
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face();"
    }
  },
  "pages": [
    {
      "id": "line_1",
      "speaker": "npc",
      "lines": [
        "Welcome home."
      ],
      "input": [
        "q.dialogue.set_page('line_2');"
      ]
    },
    {
      "id": "line_2",
      "speaker": "npc",
      "lines": [
        "It sounds like you had quite the experience out there."
      ],
      "input": [
        "q.dialogue.set_page('line_3');"
      ]
    },
    {
      "id": "line_3",
      "speaker": "npc",
      "lines": [
        "Maybe you should take a quick rest so you can relax."
      ],
      "input": [
        "q.player.heal();",
        "q.player.party.heal();",
        "q.player.play_sound_on_server('ccs:healed','blocks');",
        "q.dialogue.set_page('line_4');"
      ]
    },
    {
      "id": "line_4",
      "speaker": "npc",
      "lines": [
        "There! All happy and healthy!",
        "Good luck and take care!"
      ],
      "input": [
        "q.dialogue.close();"
      ]
    },
    {}
  ]
}