{
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face();"
    }
  },
  "pages": [
    {
      "id": "line_0",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "v.reward_type='function';",
          "v.reward='starter_kit_daisy';",
          "t.reward_landing = q.run_script('ccs:reward__landing');",
          "t.next_page = t.reward_landing == 'reward_give' ? 'line_1' : t.reward_landing;",
          "q.dialogue.set_page(t.next_page)"
        ]
      }
    },
    {
      "id": "reward_give",
      "speaker": "npc",
      "lines": [
        "Here, this will help you."
      ],
      "input": [
        "q.run_script('ccs:give_reward');",
        "q.dialogue.set_page('reward_gave');"
      ]
    },
    {
      "id": "reward_gave",
      "speaker": "npc",
      "lines": [
        "Good luck, and take care!"
      ],
      "input": [
        "q.dialogue.close();"
      ]
    },
    {
      "id": "bye",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "q.dialogue.close();"
        ]
      }
    },
    {
      "id": "line_1",
      "speaker": "npc",
      "lines": [
        "Just like people, Pok\u00e9mon are living things."
      ],
      "input": [
        "q.dialogue.set_page('line_2');"
      ]
    },
    {
      "id": "line_2",
      "speaker": "npc",
      "lines": [
        "When they get tired, please give them a rest."
      ],
      "input": [
        "q.dialogue.set_page('line_3');"
      ]
    },
    {
      "id": "line_3",
      "speaker": "npc",
      "lines": [
        "Grandpa asked you to run an errand? Gee, that's lazy of him. "
      ],
      "input": [
        "q.dialogue.set_page('reward_give');"
      ]
    }
  ]
}