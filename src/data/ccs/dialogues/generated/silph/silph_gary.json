{
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face();"
    }
  },
  "pages": [
    {
      "id": "line_0",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "t.next_page = q.run_script('ccs:battle__landing');",
          "q.dialogue.set_page(t.next_page);"
        ]
      }
    },
    {
      "id": "line_1",
      "speaker": "npc",
      "lines": [
        "What kept you? Hahaha! I thought you'd turn up if I waited here!"
      ],
      "input": [
        "q.dialogue.set_page('line_2');"
      ]
    },
    {
      "id": "line_2",
      "speaker": "npc",
      "lines": [
        "I guess Team Rocket slowed you down! Not that I care!"
      ],
      "input": [
        "q.dialogue.set_page('battle');"
      ]
    },
    {
      "id": "battle",
      "speaker": "npc",
      "lines": [
        "I saw you in Saffron, so I decided to see if you got better!"
      ],
      "input": [
        "v.min_level='50';",
        "v.advancement='ccs:kanto/saffron/gary';",
        "q.player.set_npc_variable(q.npc, 'advancement', v.advancement);",
        "q.player.set_npc_variable(q.npc, 'trainer_id', 'rival_gary');",
        "q.dialogue.close();",
        "!q.is_blank(v.min_level) ? q.player.set_npc_variable(q.npc, 'min_level', v.min_level);",
        "!q.is_blank(v.advancement) ? q.run_command('/execute at @e[type=marker,tag=rival_gary,limit=1,sort=nearest] run tp ' + q.player.username() + ' ~ ~ ~ facing entity ' + q.npc.uuid() );",
        "q.npc.start_battle(q.player, 'single');"
      ]
    },
    {
      "id": "win",
      "speaker": "npc",
      "lines": [
        "Well! I'm heading to the Pok\u00e9mon League to kick out the Elite Four!"
      ],
      "input": [
        "t.next_page = q.run_script('ccs:battle__landing_win');",
        "q.dialogue.set_page(t.next_page);"
      ]
    },
    {
      "id": "won",
      "speaker": "npc",
      "lines": [
        "I'll become the world's most powerful trainer! Smell ya!"
      ],
      "input": [
        "q.dialogue.close();"
      ]
    },
    {
      "id": "bye",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "q.dialogue.close();"
        ]
      }
    }
  ]
}