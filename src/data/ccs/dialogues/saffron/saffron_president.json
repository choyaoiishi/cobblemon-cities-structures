    {
      "id": "line_1",
      "speaker": "npc",
      "lines": [
        "Thank you for saving Silph! I will never forget you saved us in our moment of peril!"
      ]
    },
    {
      "id": "line_2",
      "speaker": "npc",
      "lines": [
        "I have to thank you in some way! Because I am rich, I can give you anything!"
      ],
      "input": [
        
        "q.dialogue.set_page('reward_give')"
      ]
    },
    {
      "id": "reward_give",
      "speaker": "npc",
      "lines": [
        "Here, maybe this will do!"
      ],
      "input": [
        "q.run_script('ccs:give_reward');",
        "q.dialogue.set_page('reward_gave');"
      ]
    },
    {
      "id": "reward_gave",
      "speaker": "npc",
      "lines": [
        {
          "type": "expression",
          "expression": "v.reward_gave_line"
        }
      ],
      "input": [
        "q.dialogue.close();"
      ]
