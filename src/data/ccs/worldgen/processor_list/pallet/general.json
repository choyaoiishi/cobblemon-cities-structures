{
    "processors": [
        {
            "processor_type": "lithostitched:reference",
            "processor_lists": [
                "ccs:pallet/base",
                "ccs:pallet/berry"
            ]
        },
        {
            "processor_type": "lithostitched:block_swap",
            "blocks": {
                "minecraft:stripped_warped_hyphae": "minecraft:stripped_mangrove_wood",
                "minecraft:prismarine_bricks": "minecraft:red_concrete",
                "minecraft:stripped_spruce_wood": "minecraft:quartz_bricks",
                "minecraft:stripped_oak_wood": "minecraft:smooth_quartz",
                "minecraft:spruce_planks": "minecraft:quartz_block",
                "minecraft:spruce_slab": "minecraft:quartz_slab",
                "minecraft:spruce_door": "minecraft:dark_oak_door",
                "minecraft:spruce_trapdoor": "minecraft:dark_oak_trapdoor",
                "minecraft:spruce_fence": "minecraft:dark_oak_fence",
                // furnies
                "cobblefurnies:black_sofa": "cobblefurnies:red_sofa",
                "cobblefurnies:black_armchair": "cobblefurnies:red_armchair",
                "cobblefurnies:black_dark_table": "cobblefurnies:red_dark_table",
                "cobblefurnies:black_poke_wool": "cobblefurnies:red_poke_wool",
                "cobblefurnies:black_poke_wool_carpet": "cobblefurnies:red_poke_wool_carpet",
                "cobblemon:black_plaque": "cobblemon:red_plaque",
                "cobblemon:campfire_pot_black": "cobblemon:campfire_pot_red",
                "minecraft:black_bed": "minecraft:red_bed",
                // lamp
                // "minecraft:polished_blackstone_wall": "minecraft:andesite_wall",
                // deco
                "minecraft:brick_slab": "minecraft:air"
            }
        },
        {
            "processor_type": "lithostitched:reference",
            "processor_lists": [
                "ccs:others/red",
                "ccs:others/blue"
            ]
        },
        {
            "processor_type": "lithostitched:condition",
            "random_mode": "per_piece",
            "if_true": {
                "type": "lithostitched:all_of",
                "conditions": [
                    {
                        "type": "lithostitched:matching_blocks",
                        "blocks": "minecraft:red_tulip",
                        "match_type": "input"
                    }
                ]
            },
            "then": {
                "processor_type": "lithostitched:set_block",
                "state_provider": {
                    "type": "minecraft:weighted_state_provider",
                    "entries": [
                       {
                        "weight": 1,
                        "data": {
                            "Name": "minecraft:blue_orchid"
                        }
                    },
                    {
                        "weight": 1,
                        "data": {
                            "Name": "minecraft:cornflower"
                        }
                    },
                    {
                        "weight": 1,
                        "data": {
                            "Name": "minecraft:azure_bluet"
                        }
                    },
                    {
                        "weight": 1,
                        "data": {
                            "Name": "minecraft:white_tulip"
                        }
                    },
                    {
                        "weight": 1,
                        "data": {
                            "Name": "minecraft:oxeye_daisy"
                        }
                    }
                    ]
                },
                "random_mode": "per_piece"
            },
            "else": {
                "processor_type": "minecraft:nop"
            }
        }
    ]
}