{
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face();"
    }
  },
  "pages": [
    {
      "id": "line_0",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "t.next_page = q.run_script('ccs:battle__landing');",
          "q.dialogue.set_page(t.next_page);"
        ]
      }
    },
    {
      "id": "line_1",
      "speaker": "npc",
      "lines": [
        "Oh hey! It's been a while. I've snagged two badges since we first met."
      ],
      "input": [
        "q.dialogue.set_page('battle');"
      ]
    },
    {
      "id": "battle",
      "speaker": "npc",
      "lines": [
        "You too huh? I thought so! Let's put each other to the test."
      ],
      "input": [
        "v.min_level='35';",
        "v.advancement='ccs:kanto/vermilion/brendan';",
        "q.player.set_npc_variable(q.npc, 'advancement', v.advancement);",
        "q.player.set_npc_variable(q.npc, 'trainer_id', 'rival_brendan');",
        "q.dialogue.close();",
        "!q.is_blank(v.min_level) ? q.player.set_npc_variable(q.npc, 'min_level', v.min_level);",
        "!q.is_blank(v.advancement) ? q.run_command('/execute at @e[type=marker,tag=rival_brendan,limit=1,sort=nearest] run tp ' + q.player.username() + ' ~ ~ ~ facing entity ' + q.npc.uuid() );",
        "q.npc.start_battle(q.player, 'single');"
      ]
    },
    {
      "id": "win",
      "speaker": "npc",
      "lines": [
        "You're seriously just a step ahead of me. It's admirable, really."
      ],
      "input": [
        "v.reward_type='item';",
        "v.reward='cobblemon:lucky_egg';",
        "t.next_page = q.run_script('ccs:battle__landing_win');",
        "q.dialogue.set_page(t.next_page)"
      ]
    },
    {
      "id": "reward_give",
      "speaker": "npc",
      "lines": [
        "I've got another useful item for you, my friend."
      ],
      "input": [
        "q.run_script('ccs:give_reward');",
        "q.dialogue.set_page('reward_gave');"
      ]
    },
    {
      "id": "reward_gave",
      "speaker": "npc",
      "lines": [
        "The Lucky Egg speeds up training significantly. I hope you put it to good use. Well, it's back to training for me."
      ],
      "input": [
        "q.dialogue.close();"
      ]
    },
    {
      "id": "won",
      "speaker": "npc",
      "lines": [
        "The Lucky Egg speeds up training significantly. I hope you put it to good use. Well, it's back to training for me."
      ],
      "input": [
        "q.dialogue.close();"
      ]
    },
    {
      "id": "bye",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "q.dialogue.close();"
        ]
      }
    }
  ]
}