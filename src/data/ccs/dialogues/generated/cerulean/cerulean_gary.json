{
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face();"
    }
  },
  "pages": [
    {
      "id": "line_0",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "t.next_page = q.run_script('ccs:battle__landing');",
          "q.dialogue.set_page(t.next_page);"
        ]
      }
    },
    {
      "id": "line_1",
      "speaker": "npc",
      "lines": [
        "You're still struggling along back here? I'm doing great! I caught a bunch of strong and smart Pok\u00e9mon!"
      ],
      "input": [
        "q.dialogue.set_page('battle');"
      ]
    },
    {
      "id": "battle",
      "speaker": "npc",
      "lines": [
        "Here, let me see what you caught!"
      ],
      "input": [
        "v.min_level='25';",
        "v.advancement='ccs:kanto/cerulean/gary';",
        "q.player.set_npc_variable(q.npc, 'advancement', v.advancement);",
        "q.player.set_npc_variable(q.npc, 'trainer_id', 'rival_gary');",
        "q.dialogue.close();",
        "!q.is_blank(v.min_level) ? q.player.set_npc_variable(q.npc, 'min_level', v.min_level);",
        "!q.is_blank(v.advancement) ? q.run_command('/execute at @e[type=marker,tag=rival_gary,limit=1,sort=nearest] run tp ' + q.player.username() + ' ~ ~ ~ facing entity ' + q.npc.uuid() );",
        "q.npc.start_battle(q.player, 'single');"
      ]
    },
    {
      "id": "win",
      "speaker": "npc",
      "lines": [
        "Hey! Take it easy! You won already!"
      ],
      "input": [
        "t.next_page = q.run_script('ccs:battle__landing_win');",
        "q.dialogue.set_page(t.next_page);"
      ]
    },
    {
      "id": "won",
      "speaker": "npc",
      "lines": [
        "Hey, guess what? I went to Bill and got him to show me his rare Pok\u00e9mon! Since you are using his system, go thank him! Well, I better get rolling! Smell ya later!"
      ],
      "input": [
        "q.dialogue.close();"
      ]
    },
    {
      "id": "bye",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "q.dialogue.close();"
        ]
      }
    }
  ]
}