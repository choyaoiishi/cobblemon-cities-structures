    },
    {
      "id": "10",
      "speaker": "npc",
      "lines": [
        "My plan for world domination is but a dream..."
      ],
      "input": [
        "q.dialogue.set_page('11');"
      ]
    },
    {
      "id": "11",
      "speaker": "npc",
      "lines": [
        "I threw aside family for this..."
