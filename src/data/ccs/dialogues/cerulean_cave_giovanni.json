      "input": [
        "q.dialogue.set_page('15');"
      ]
    },
    {
      "id": "15",
      "speaker": "npc",
      "lines": [
        "But, I've given up literally everything for this..."
      ],
      "input": [
        "q.dialogue.set_page('16');"
      ]
    },
    {
      "id": "16",
      "speaker": "npc3",
      "lines": [
        "Boss!"
      ],
