{
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face();"
    }
  },
  "pages": [
    {
      "id": "line_0",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "t.next_page = q.run_script('ccs:battle__landing');",
          "q.dialogue.set_page(t.next_page);"
        ]
      }
    },
    {
      "id": "line_1",
      "speaker": "npc",
      "lines": [
        "Hey, kid! What do you think you're doing here? You won't live long in combat!"
      ],
      "input": [
        "q.dialogue.set_page('line_2');"
      ]
    },
    {
      "id": "line_2",
      "speaker": "npc",
      "lines": [
        "That's for sure! I tell you kid, electric Pok\u00e9mon saved me during the war!"
      ],
      "input": [
        "q.dialogue.set_page('battle');"
      ]
    },
    {
      "id": "battle",
      "speaker": "npc",
      "lines": [
        "They zapped my enemies into paralysis! The same as I'll do to you!"
      ],
      "input": [
        "v.min_level='35';",
        "v.advancement='ccs:kanto/vermilion/lt_surge';",
        "q.player.set_npc_variable(q.npc, 'advancement', v.advancement);",
        "q.player.set_npc_variable(q.npc, 'trainer_id', 'leader_lt_surge');",
        "q.dialogue.close();",
        "!q.is_blank(v.min_level) ? q.player.set_npc_variable(q.npc, 'min_level', v.min_level);",
        "!q.is_blank(v.advancement) ? q.run_command('/execute at @e[type=marker,tag=leader_lt_surge,limit=1,sort=nearest] run tp ' + q.player.username() + ' ~ ~ ~ facing entity ' + q.npc.uuid() );",
        "q.npc.start_battle(q.player, 'single');"
      ]
    },
    {
      "id": "win",
      "speaker": "npc",
      "lines": [
        "Whoa! You're the real deal, kid! Fine then, take the Thunder Badge!"
      ],
      "input": [
        "v.reward_type='tm';",
        "v.reward='shockwave';",
        "t.next_page = q.run_script('ccs:battle__landing_win');",
        "q.dialogue.set_page(t.next_page)"
      ]
    },
    {
      "id": "reward_give",
      "speaker": "npc",
      "lines": [
        "You're special, kid! Take this!"
      ],
      "input": [
        "q.run_script('ccs:give_reward');",
        "q.dialogue.set_page('reward_gave');"
      ]
    },
    {
      "id": "reward_gave",
      "speaker": "npc",
      "lines": [
        "TM34 contains Shock Wave! Teach it to an Electric Pok\u00e9mon!"
      ],
      "input": [
        "q.dialogue.close();"
      ]
    },
    {
      "id": "won",
      "speaker": "npc",
      "lines": [
        "A little word of advice, kid! Electricity is sure powerful! But, it's useless against ground-type Pok\u00e9mon!"
      ],
      "input": [
        "q.dialogue.close();"
      ]
    },
    {
      "id": "bye",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "q.dialogue.close();"
        ]
      }
    }
  ]
}