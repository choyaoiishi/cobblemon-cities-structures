{
  "initializationAction": "(q.npc.is_in_battle_with(q.player) || !q.npc.is_doing_activity('minecraft:idle', 'cobblemon:battling')) ? q.dialogue.close()",
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face();"
    },
    "npc2": {
      "name": "Archer",
      "face": {
        "type": "artificial",
        "modelType": "npc",
        "identifier": "ccs:rocket/archer",
        "isLeftSide": false,
        "aspects": []
      }
    }
  },
  "pages": [
    {
      "id": "line_0",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "t.next_page = q.run_script('ccs:battle__landing');",
          "q.dialogue.set_page(t.next_page);"
        ]
      }
    },
    {
      "id": "line_1",
      "speaker": "npc",
      "lines": [
        "Looks like we found our intruder."
      ],
      "input": [
        "q.dialogue.set_page('line_2');"
      ]
    },
    {
      "id": "line_2",
      "speaker": "npc2",
      "lines": [
        "Wait a sec... This is the punk I ran into at Pewter!"
      ],
      "input": [
        "q.dialogue.set_page('line_3');"
      ]
    },
    {
      "id": "line_3",
      "speaker": "npc",
      "lines": [
        "Wow, you lost to this loser?"
      ],
      "input": [
        "q.dialogue.set_page('line_4');"
      ]
    },
    {
      "id": "line_4",
      "speaker": "npc2",
      "lines": [
        "Quiet, I'm sure my Mightyena gave this punk a scare."
      ],
      "input": [
        "q.dialogue.set_page('line_5');"
      ]
    },
    {
      "id": "line_5",
      "speaker": "npc",
      "lines": [
        "Your Mightyena doesn't even have Intimidate."
      ],
      "input": [
        "q.dialogue.set_page('line_6');"
      ]
    },
    {
      "id": "line_6",
      "speaker": "npc2",
      "lines": [
        "Would you SHUT UP Ari?! We've got things to deal with here."
      ],
      "input": [
        "q.dialogue.set_page('battle');"
      ]
    },
    {
      "id": "battle",
      "speaker": "npc",
      "lines": [
        "Fine. Sorry kid, looks like your fun ends here."
      ],
      "input": [
        "q.player.set_npc_variable(q.npc, 'advancement', 'ccs:kanto/saffron/ariana_archer');",
        "q.player.set_npc_variable(q.npc, 'trainer_id', 'rocket_ariana_archer');",
        "q.dialogue.close();",
        "q.run_command('/execute at @e[type=marker,tag=ariana_archer,limit=1,sort=nearest] run tp ' + q.player.username() + ' ~ ~ ~ facing entity ' + q.npc.uuid() );",
        "q.npc.start_battle(q.player, 'doubles');"
      ]
    },
    {
      "id": "win",
      "speaker": "npc",
      "lines": [
        "Damn it. I really hate them kids. I'm shocked. Boss won't be happy about this."
      ],
      "input": [
        "t.next_page = q.run_script('ccs:battle__landing_win');",
        "q.dialogue.set_page(t.next_page);"
      ]
    },
    {
      "id": "won",
      "speaker": "npc",
      "lines": [
        "Pray you don't meet me again."
      ],
      "input": [
        "q.dialogue.close();"
      ]
    },
    {
      "id": "bye",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": "q.dialogue.close();"
      }
    }
  ]
}