{
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face();"
    },
    "player": {
      "face": "q.player.face();",
      "name": {
        "type": "expression",
        "expression": "q.player.username"
      }
    }
  },
  "pages": [
    {
      "id": "welcome_1",
      "speaker": "npc",
      "lines": [
        "Welcome to Vermilion City! The Port of Exquisite Sunsets!"
      ],
      "input": "q.dialogue.set_page('welcome_2');"
    },
    {
      "id": "welcome_2",
      "speaker": "npc",
      "lines": [
        "What would you like to learn about?"
      ],
      "input": {
        "type": "option",
        "vertical": true,
        "options": [
          {
            "text": "Gym",
            "value": "gym",
            "action": [
              "q.dialogue.set_page('gym_1');"
            ]
          },
          {
            "text": "Celadon City",
            "value": "map",
            "action": [
              "t.npc_data = q.player.get_npc_data(q.npc); t.next_page = t.npc_data.map_gave == 1 ? 'map_gave' : 'map_1'; q.dialogue.set_page(t.next_page)"
            ]
          },
          {
            "text": "Nothing",
            "value": "nothing",
            "action": [
              "q.dialogue.set_page('quitter');"
            ]
          }
        ]
      }
    },
    {
      "id": "map_1",
      "speaker": "npc",
      "lines": [
        "Heading to Celadon City? Here, take this MAP!"
      ],
      "input": [
        "q.run_command('loot give ' + q.player.username() + ' loot ccs:maps/celadon');",
        "q.player.play_sound_on_server('ccs:item_get','blocks');",
        "q.player.set_npc_variable(q.npc, 'map_gave', 1);",
        "q.dialogue.close();"
      ]
    },
    {
      "id": "map_gave",
      "speaker": "npc",
      "lines": [
        "Use that MAP to find your way to Celadon City! Travel safe!"
      ],
      "input": "q.dialogue.close();"
    },
    {
      "id": "gym_1",
      "speaker": "npc",
      "lines": [
        "Yo! Champ in the making! Lt. Surge has a nickname. People refer to him as the Lightning American!"
      ],
      "input": "q.dialogue.set_page('gym_2');"
    },
    {
      "id": "gym_2",
      "speaker": "npc",
      "lines": [
        "He's an expert on electric Pokémon. Bird/Water-type Pokémon match poorly against the Electric type."
      ],
      "input": "q.dialogue.set_page('gym_3');"
    },
    {
      "id": "gym_3",
      "speaker": "npc",
      "lines": [
        "You'll also want to watch out so your Pokémon don't get stuck paralyzed!"
      ],
      "input": "q.dialogue.close();"
    },
    {
      "id": "quitter",
      "speaker": "npc",
      "lines": [
        "Awww! Oh well..."
      ],
      "input": "q.dialogue.close();",
      "escapeAction": "q.dialogue.close();"
    }
  ]
}