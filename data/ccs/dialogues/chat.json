      "lines": [
        {
          "type": "expression",
          "expression": "q.npc.config.line_2"
        }
      ],
      "input": [
        "q.npc.config.line_3 != '' ? q.dialogue.set_page('line_3') : q.dialogue.close();"
      ]
    },
    {
      "id": "line_3",
      "speaker": "npc",
      "lines": [
        {
          "type": "expression",
          "expression": "q.npc.config.line_3"
        }
      ],
      "input": [
        "q.dialogue.close();"
      ]
    }
  ]
