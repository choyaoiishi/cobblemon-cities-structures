      "input": [
        "q.dialogue.set_page('12');"
      ]
    },
    {
      "id": "12",
      "speaker": "npc",
      "lines": [
        "Abandoned my wife, even my own son..."
      ],
      "input": [
        "q.dialogue.set_page('13');"
      ]
    },
    {
      "id": "13",
      "speaker": "npc",
      "lines": [
        "Despite my defeat at Silph Co, I couldn't give up on my plan."
      ],
      "input": [
        "q.dialogue.set_page('14');"
      ]
    },
    {
      "id": "14",
      "speaker": "npc",
      "lines": [
        "I admit, I was a victim of the sunk-cost fallacy..."
