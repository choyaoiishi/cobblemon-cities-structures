{
  "initializationAction": [
    "t.server = q.player.world.server();",
    "t.data = t.server.data();",
    "t.data.disable_oak_welcome == 1 ? q.dialogue.close();"
  ],
  "speakers": {
    "npc": {
      "name": "Professor Oak",
      "face": {
        "type": "artificial",
        "modelType": "npc",
        "identifier": "ccs:prof_oak",
        "aspects": []
      }
    }
  },
  "pages": [
    {
      "id": "welcome",
      "speaker": "npc",
      "lines": [
        "Hello there! Welcome to Cobblemon Cities & Structures! My name is Oak. People call me the Pokémon Professor!"
      ],
      "input": {
        "type": "option",
        "vertical": true,
        "options": [
          {
            "text": "Next",
            "value": "next",
            "action": [
              "v.data = q.player.data();",
              "q.dialogue.set_page('main_menu');"
            ]
          }
        ]
      }
    },
    {
      "id": "main_menu",
      "speaker": "npc",
      "lines": [
        "Now, before you set off on your journey, let us adjust a few settings!"
      ],
      "input": {
        "type": "option",
        "vertical": true,
        "options": [
          {
            "text": "Start at Pallet Town",
            "value": "tp_pallet",
            "action": [
              "v.spawn_location = 'pallet';",
              "v.city_name = 'Pallet Town';",
              "v.tp_function = 'ccs:tp_pallet';",
              "q.dialogue.set_page('tp_location');"
            ]
          },
          {
            "text": "Start at Pewter City",
            "value": "tp_pewter",
            "action": [
              "v.spawn_location = 'pewter';",
              "v.city_name = 'Pewter City';",
              "v.tp_function = 'ccs:tp_pewter';",
              "q.dialogue.set_page('tp_location');"
            ]
          },
          {
            "text": "Close Menu",
            "value": "close",
            "action": [
              "q.dialogue.close();"
            ]
          }
        ]
      }
    },
    {
      "id": "tp_location",
      "speaker": "npc",
      "lines": [
        {
          "type": "expression",
          "expression": "'Do you wish to start your journey directly at ' + v.city_name + '?'"
        }
      ],
      "input": {
        "type": "option",
        "vertical": true,
        "options": [
          {
            "text": "Yes, take me there!",
            "value": "confirm_tp",
            "action": [
              "q.dialogue.set_page('tp_process');"
            ]
          },
          {
            "text": "Back",
            "value": "back",
            "action": [
              "q.dialogue.set_page('main_menu');"
            ]
          }
        ]
      }
    },
    {
      "id": "tp_process",
      "speaker": "npc",
      "lines": [
        {
          "type": "expression",
          "expression": "'Just wait a moment! Locating ' + v.city_name + '...'"
        }
      ],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "q.run_command('execute as ' + q.player.username() + ' run function ' + v.tp_function);",
          "v.spawn_location == 'pewter' ? q.dialogue.set_page('starter_kit_prompt') : q.dialogue.set_page('tp_pallet_done');"
        ]
      }
    },
    {
      "id": "starter_kit_prompt",
      "speaker": "npc",
      "lines": [
        "Do you wish to receive your starter kit?"
      ],
      "input": {
        "type": "option",
        "vertical": true,
        "options": [
          {
            "text": "Yes",
            "value": "yes",
            "isSelectable": "v.data.kit_received!=1",
            "action": [
              "q.run_command('execute as ' + q.player.username() + ' run function ccs:starter_kit');",
              "q.player.play_sound_on_server('ccs:item_get', 'blocks');",
              "v.data.kit_received = 1; q.player.save_data();",
              "q.dialogue.set_page('kit_received');"
            ]
          },
          {
            "text": "No",
            "value": "no",
            "action": [
              "q.dialogue.set_page('tp_done');"
            ]
          }
        ]
      }
    },
    {
      "id": "kit_received",
      "speaker": "npc",
      "lines": [
        "Starter kit received!"
      ],
      "input": {
        "type": "auto-continue",
        "delay": 1.0,
        "action": [
          "q.dialogue.set_page('tp_done');"
        ]
      }
    },
    {
      "id": "tp_pallet_done",
      "speaker": "npc",
      "lines": [
        "All set! Come visit me at my lab, I have something to give you!"
      ],
      "input": {
        "type": "option",
        "vertical": true,
        "options": [
          {
            "text": "Done",
            "value": "done",
            "action": [
              "q.dialogue.close();"
            ]
          }
        ]
      }
    },
    {
      "id": "tp_done",
      "speaker": "npc",
      "lines": [
        "All set! A world of dreams and adventures with Pokémon awaits! Let's go!"
      ],
      "input": {
        "type": "option",
        "vertical": true,
        "options": [
          {
            "text": "Done",
            "value": "done",
            "action": [
              "q.dialogue.close();"
            ]
          }
        ]
      }
    }
  ]
}