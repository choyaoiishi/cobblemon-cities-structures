{
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face();"
    }
  },
  "pages": [
    {
      "id": "line_0",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "v.reward_type='pokemon';",
          "v.reward='lapras';",
          "t.reward_landing = q.run_script('ccs:reward__landing');",
          "t.next_page = t.reward_landing == 'reward_give' ? 'line_1' : t.reward_landing;",
          "q.dialogue.set_page(t.next_page)"
        ]
      }
    },
    {
      "id": "reward_give",
      "speaker": "npc",
      "lines": [
        "I want you to have this Pok\u00e9mon for saving us."
      ],
      "input": [
        "q.run_script('ccs:give_reward');",
        "q.dialogue.set_page('reward_gave');"
      ]
    },
    {
      "id": "reward_gave",
      "speaker": "npc",
      "lines": [
        "It's Lapras. It's very intelligent and will be much better off with you!"
      ],
      "input": [
        "q.dialogue.close();"
      ]
    },
    {
      "id": "bye",
      "speaker": "npc",
      "lines": [],
      "input": {
        "type": "auto-continue",
        "delay": 0.01,
        "allowSkip": false,
        "action": [
          "q.dialogue.close();"
        ]
      }
    },
    {
      "id": "line_1",
      "speaker": "npc",
      "lines": [
        "Oh! Hi! You're not with Team Rocket!"
      ],
      "input": [
        "q.dialogue.set_page('line_2');"
      ]
    },
    {
      "id": "line_2",
      "speaker": "npc",
      "lines": [
        "You came to save us? Why, thank you!"
      ],
      "input": [
        "q.dialogue.set_page('reward_give');"
      ]
    }
  ]
}