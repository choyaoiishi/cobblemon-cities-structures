      ]
    },
    {
      "id": "line_2",
      "speaker": "npc",
      "lines": [
        "I am Lorelei of the Elite Four."
      ],
      "input": [
        "q.dialogue.set_page('line_3');"
      ]
    },
    {
      "id": "line_3",
      "speaker": "npc",
      "lines": [
        "No one can best me when it comes to icy Pok\u00e9mon."
      ],
      "input": [
        "q.dialogue.set_page('line_4');"
      ]
    },
    {
      "id": "line_4",
      "speaker": "npc",
      "lines": [
        "Freezing moves are powerful."
      ],
      "input": [
        "q.dialogue.set_page('line_5');"
      ]
    },
    {
      "id": "line_5",
      "speaker": "npc",
      "lines": [
        "Your Pok\u00e9mon will be at my mercy when they are frozen solid."
      ],
      "input": [
        "q.dialogue.set_page('battle');"
      ]
    },
    {
      "id": "battle",
      "speaker": "npc",
      "lines": [
        "Hahaha! Are you ready?"
      ],
      "input": [
        "v.min_level='85';",
        "v.advancement='ccs:kanto/indigo_plateau/lorelei';",
        "q.player.set_npc_variable(q.npc, 'advancement', v.advancement);",
        "q.player.set_npc_variable(q.npc, 'trainer_id', 'elite_lorelei');",
        "q.dialogue.close();",
        "!q.is_blank(v.min_level) ? q.player.set_npc_variable(q.npc, 'min_level', v.min_level);",
        "!q.is_blank(v.advancement) ? q.run_command('/execute at @e[type=marker,tag=elite_lorelei,limit=1,sort=nearest] run tp ' + q.player.username() + ' ~ ~ ~ facing entity ' + q.npc.uuid() );",
        "q.npc.start_battle(q.player, 'single');"
      ]
    },
    {
      "id": "win",
      "speaker": "npc",
      "lines": [
        "\u2026Things shouldn't be this way!"
      ],
      "input": [
        "t.next_page = q.run_script('ccs:battle__landing_win');",
        "q.dialogue.set_page(t.next_page);"
      ]
    },
    {
      "id": "won",
      "speaker": "npc",
      "lines": [
        "You're better than I thought. Go on ahead. You only got a taste of the Pok\u00e9mon League's power."
